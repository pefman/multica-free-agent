#!/usr/bin/env bash
# Stub-PATH tests for bin/multica-free-agent.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0
FAIL=0

fail() {
  echo "FAIL $1" >&2
  FAIL=$((FAIL + 1))
}

ok() {
  echo "ok $1"
  PASS=$((PASS + 1))
}

assert_eq() {
  local name=$1 got=$2 want=$3
  if [[ "$got" == "$want" ]]; then
    ok "$name"
  else
    fail "$name (got=$(printf %q "$got") want=$(printf %q "$want"))"
  fi
}

assert_ok() {
  local name=$1
  shift
  if "$@"; then
    ok "$name"
  else
    fail "$name"
  fi
}

LIB="$ROOT/bin/multica-free-agent"
if [[ ! -f "$LIB" ]]; then
  echo "FAIL bin/multica-free-agent missing" >&2
  exit 1
fi

# shellcheck disable=SC1090
MULTICA_FREE_AGENT_LIB=1 source "$LIB"

# --- load_api_key: missing key, non-interactive ---
(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  export HOME="$tmp"
  export XDG_CONFIG_HOME="$tmp/.config"
  unset OPENROUTER_API_KEY || true
  export MULTICA_FREE_AGENT_NONINTERACTIVE=1
  MULTICA_FREE_AGENT_LIB=1 source "$LIB"
  if load_api_key >/dev/null 2>&1; then
    exit 1
  fi
  exit 0
) && ok "load_api_key fails without key in non-interactive" || fail "load_api_key fails without key in non-interactive"

# --- load_api_key: env wins, no file created ---
(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  export HOME="$tmp"
  export XDG_CONFIG_HOME="$tmp/.config"
  export OPENROUTER_API_KEY="sk-or-test"
  export MULTICA_FREE_AGENT_NONINTERACTIVE=1
  MULTICA_FREE_AGENT_LIB=1 source "$LIB"
  got=$(load_api_key)
  [[ "$got" == "sk-or-test" ]] || { echo "got=$got" >&2; exit 1; }
  [[ ! -e "$tmp/.config/multica-free-agent/api_key" ]] || exit 1
) && ok "load_api_key uses OPENROUTER_API_KEY without creating file" || fail "load_api_key uses OPENROUTER_API_KEY without creating file"

# --- save_api_key permissions ---
(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  export HOME="$tmp"
  export XDG_CONFIG_HOME="$tmp/.config"
  unset OPENROUTER_API_KEY || true
  MULTICA_FREE_AGENT_LIB=1 source "$LIB"
  save_api_key "sk-or-saved"
  f="$tmp/.config/multica-free-agent/api_key"
  [[ -f "$f" ]] || exit 1
  got=$(cat "$f")
  [[ "$got" == "sk-or-saved" ]] || { echo "got=$got" >&2; exit 1; }
  dmod=$(stat -c '%a' "$tmp/.config/multica-free-agent")
  fmod=$(stat -c '%a' "$f")
  [[ "$dmod" == "700" ]] || { echo "dir mode=$dmod" >&2; exit 1; }
  [[ "$fmod" == "600" ]] || { echo "file mode=$fmod" >&2; exit 1; }
) && ok "save_api_key writes 0700 dir and 0600 file" || fail "save_api_key writes 0700 dir and 0600 file"

# --- free_models_json ---
(
  MULTICA_FREE_AGENT_LIB=1 source "$LIB"
  json=$(free_models_json <"$ROOT/tests/fixtures/models.json")
  ids=$(printf '%s' "$json" | jq -r '.[].id' | sort | tr '\n' ' ')
  # paid gpt-4o and claude must be gone; :free, zero-priced llama, and injected openrouter/free remain
  want="meta-llama/llama-3.2-1b-instruct nvidia/nemotron-3-ultra-550b-a55b:free openrouter/free "
  [[ "$ids" == "$want" ]] || { echo "ids=$ids" >&2; exit 1; }
  printf '%s' "$json" | jq -e 'all(.[]; has("id") and has("name") and has("context_length"))' >/dev/null
) && ok "free_models_json keeps free rows and injects openrouter/free" || fail "free_models_json keeps free rows and injects openrouter/free"

# --- Task 2: discovery + model mapping ---
with_stub() {
  export PATH="$ROOT/tests/stubs:$PATH"
  export MULTICA_FREE_AGENT_NONINTERACTIVE=1
  unset OPENROUTER_API_KEY || true
  MULTICA_FREE_AGENT_LIB=1 source "$LIB"
}

(
  with_stub
  groups=$(list_runtime_groups)
  labels=$(printf '%s' "$groups" | jq -r '.[] | "\(.provider) @ \(.machine)"' | tr '\n' '|')
  [[ "$labels" == *"opencode @ omarchy-4090"* ]] || { echo "labels=$labels" >&2; exit 1; }
  [[ "$labels" == *"omp @ omarchy-4090"* ]] || { echo "labels=$labels" >&2; exit 1; }
  [[ "$labels" != *"pef-4090"* ]] || { echo "offline leaked: $labels" >&2; exit 1; }
  [[ "$labels" != *"claude"* ]] || { echo "cloud leaked: $labels" >&2; exit 1; }
  first=$(printf '%s' "$groups" | jq -r '.[0].provider')
  [[ "$first" == "omp" || "$first" == "opencode" || "$first" == "pi" || "$first" == "hermes" ]] || { echo "first=$first" >&2; exit 1; }
) && ok "list_runtime_groups keeps only online local harnesses, OR-capable first" || fail "list_runtime_groups keeps only online local harnesses, OR-capable first"

(
  with_stub
  got=$(map_model_id opencode nvidia/foo:free)
  [[ "$got" == "openrouter/nvidia/foo:free" ]] || { echo "got=$got" >&2; exit 1; }
) && ok "map_model_id prefixes opencode with openrouter/" || fail "map_model_id prefixes opencode with openrouter/"

(
  with_stub
  got=$(map_model_id opencode openrouter/free)
  [[ "$got" == "openrouter/openrouter/free" ]] || { echo "got=$got" >&2; exit 1; }
) && ok "map_model_id maps openrouter/free for opencode" || fail "map_model_id maps openrouter/free for opencode"

(
  with_stub
  got=$(resolve_runtime_id "aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa" opencode omarchy-4090)
  [[ "$got" == "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa" ]] || { echo "got=$got" >&2; exit 1; }
  other=$(resolve_runtime_id "bbbbbbbb-2222-2222-2222-bbbbbbbbbbbb" opencode omarchy-4090)
  [[ "$other" == "22222222-aaaa-aaaa-aaaa-aaaaaaaaaaaa" ]] || { echo "other=$other" >&2; exit 1; }
  [[ "$got" != "$other" ]] || exit 1
) && ok "resolve_runtime_id is per-workspace" || fail "resolve_runtime_id is per-workspace"

# --- Task 3: CLI ---
cli() {
  export PATH="$ROOT/tests/stubs:$PATH"
  export HOME="$1"
  export XDG_CONFIG_HOME="$1/.config"
  if [[ -z "${MULTICA_FREE_AGENT_TEST_NO_KEY:-}" && -z "${OPENROUTER_API_KEY+isset}" ]]; then
    export OPENROUTER_API_KEY="sk-or-test"
  fi
  export MULTICA_FREE_AGENT_NONINTERACTIVE=1
  export MULTICA_FREE_AGENT_STUB_LOG="${2:-}"
  shift 2
  "$ROOT/bin/multica-free-agent" "$@"
}

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  out=$(cli "$tmp" "" --list-models)
  printf '%s' "$out" | grep -q 'nvidia/nemotron-3-ultra-550b-a55b:free' || { echo "$out" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'openrouter/free' || { echo "$out" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'openai/gpt-4o' && exit 1
  true
) && ok "--list-models prints free ids" || fail "--list-models prints free ids"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/stub.log"
  : >"$log"
  out=$(cli "$tmp" "$log" --dry-run --model nvidia/foo:free --runtime opencode --workspace ws-a --agent AgentOne)
  printf '%s' "$out" | grep -q 'openrouter/nvidia/foo:free' || { echo "$out" >&2; exit 1; }
  if grep -q 'agent update' "$log"; then
    echo "unexpected update: $(cat "$log")" >&2
    exit 1
  fi
) && ok "--dry-run prints mapped model and does not update" || fail "--dry-run prints mapped model and does not update"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/stub.log"
  : >"$log"
  cli "$tmp" "$log" --yes --no-env --model nvidia/foo:free --runtime opencode --workspace ws-a --agent AgentOne >/dev/null
  grep -q 'agent update' "$log" || { echo "log=$(cat "$log")" >&2; exit 1; }
  grep -q '11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa' "$log" || { echo "log=$(cat "$log")" >&2; exit 1; }
  grep -q 'openrouter/nvidia/foo:free' "$log" || { echo "log=$(cat "$log")" >&2; exit 1; }
) && ok "--yes updates agent with workspace runtime id and mapped model" || fail "--yes updates agent with workspace runtime id and mapped model"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/stub.log"
  : >"$log"
  cli "$tmp" "$log" --yes --env --model nvidia/foo:free --runtime opencode --workspace ws-a --agent AgentOne >/dev/null
  grep -q 'ENVFILE' "$log" || { echo "log=$(cat "$log")" >&2; exit 1; }
  line=$(grep '^ENVFILE' "$log")
  printf '%s' "$line" | grep -q '"FISKMAS_TOKEN":"****"' || { echo "line=$line" >&2; exit 1; }
  printf '%s' "$line" | grep -q '"OPENROUTER_API_KEY":"sk-or-test"' || { echo "line=$line" >&2; exit 1; }
) && ok "--yes --env merges OPENROUTER_API_KEY and preserves other keys as ****" || fail "--yes --env merges OPENROUTER_API_KEY and preserves other keys as ****"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  if cli "$tmp" "" --yes --runtime opencode >/dev/null 2>&1; then
    exit 1
  fi
) && ok "--yes without --model fails on non-tty" || fail "--yes without --model fails on non-tty"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/.config/multica-free-agent"
  : >"$tmp/.config/multica-free-agent/api_key"
  chmod 600 "$tmp/.config/multica-free-agent/api_key"
  log="$tmp/stub.log"
  : >"$log"
  unset OPENROUTER_API_KEY || true
  export MULTICA_FREE_AGENT_TEST_NO_KEY=1
  if cli "$tmp" "$log" --yes --env --model nvidia/foo:free --runtime opencode --workspace ws-a --agent AgentOne >/dev/null 2>&1; then
    echo "empty key should fail" >&2
    exit 1
  fi
  if grep -q 'agent update' "$log"; then
    echo "empty key wrote agents: $(cat "$log")" >&2
    exit 1
  fi
) && ok "empty cached key fails and does not update agents" || fail "empty cached key fails and does not update agents"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/stub.log"
  : >"$log"
  rc=0
  out=$(MULTICA_STUB_FAIL_UPDATE=1 cli "$tmp" "$log" --yes --env --model nvidia/foo:free --runtime opencode --workspace ws-a --agent AgentOne 2>&1) || rc=$?
  [[ "$rc" -ne 0 ]] || { echo "failed update should fail the CLI: $out" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'FAIL' || { echo "no FAIL in output: $out" >&2; exit 1; }
  if grep -q 'ENVFILE' "$log"; then
    echo "env set after failed update: $(cat "$log")" >&2
    exit 1
  fi
) && ok "failed agent update is reported and skips env set" || fail "failed agent update is reported and skips env set"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/stub.log"
  : >"$log"
  out=$(cli "$tmp" "$log" --dry-run --model nvidia/foo:free --runtime omp --machine omarchy-4090 --workspace ws-a --workspace ws-b)
  printf '%s' "$out" | grep -q 'SKIP' || { echo "$out" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'AgentB' || { echo "$out" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'openrouter/nvidia/foo:free' || { echo "$out" >&2; exit 1; }
  if grep -q 'agent update' "$log"; then
    echo "dry-run updated: $(cat "$log")" >&2
    exit 1
  fi
) && ok "workspace missing harness is SKIP, others still listed" || fail "workspace missing harness is SKIP, others still listed"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  err=$(cli "$tmp" "" --yes --no-env --model nvidia/foo:free --runtime hermes 2>&1 || true)
  printf '%s' "$err" | grep -qi 'no online' || { echo "err=$err" >&2; exit 1; }
  printf '%s' "$err" | grep -q 'more than one' && { echo "wrong error: $err" >&2; exit 1; }
  true
) && ok "zero matching machines says none online, not more than one" || fail "zero matching machines says none online, not more than one"

# --- OpenCode free models (`opencode models | grep free`) ---
(
  with_stub
  json=$(opencode_free_models_json)
  ids=$(printf '%s' "$json" | jq -r '.[].id' | sort | tr '\n' ' ')
  printf '%s' "$json" | jq -e 'any(.[]; .id == "opencode/deepseek-v4.1-flash-free")' >/dev/null || { echo "ids=$ids" >&2; exit 1; }
  printf '%s' "$json" | jq -e 'any(.[]; .id == "opencode/beam-free")' >/dev/null || { echo "ids=$ids" >&2; exit 1; }
  if printf '%s' "$json" | jq -e 'any(.[]; .id == "anthropic/claude-sonnet-5")' >/dev/null; then
    echo "paid leaked: $ids" >&2
    exit 1
  fi
  if printf '%s' "$json" | jq -e 'any(.[]; .id == "openai/gpt-5.5")' >/dev/null; then
    echo "paid leaked: $ids" >&2
    exit 1
  fi
) && ok "opencode_free_models_json keeps grep-free ids only" || fail "opencode_free_models_json keeps grep-free ids only"

(
  with_stub
  got=$(map_model_id opencode opencode/deepseek-v4.1-flash-free)
  [[ "$got" == "opencode/deepseek-v4.1-flash-free" ]] || { echo "got=$got" >&2; exit 1; }
) && ok "map_model_id leaves opencode/ zen ids unchanged" || fail "map_model_id leaves opencode/ zen ids unchanged"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  unset OPENROUTER_API_KEY || true
  export MULTICA_FREE_AGENT_TEST_NO_KEY=1
  out=$(cli "$tmp" "" --list-models)
  printf '%s' "$out" | grep -q 'opencode/deepseek-v4.1-flash-free' || { echo "$out" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'opencode/beam-free' || { echo "$out" >&2; exit 1; }
) && ok "--list-models includes OpenCode free models without OpenRouter key" || fail "--list-models includes OpenCode free models without OpenRouter key"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/stub.log"
  : >"$log"
  out=$(cli "$tmp" "$log" --dry-run --model opencode/deepseek-v4.1-flash-free --runtime opencode --workspace ws-a --agent AgentOne)
  printf '%s' "$out" | grep -q 'opencode/deepseek-v4.1-flash-free' || { echo "$out" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'openrouter/opencode/' && { echo "wrong prefix: $out" >&2; exit 1; }
  if grep -q 'agent update' "$log"; then
    echo "unexpected update: $(cat "$log")" >&2
    exit 1
  fi
) && ok "--dry-run keeps opencode/ zen model id" || fail "--dry-run keeps opencode/ zen model id"

(
  with_stub
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  export PATH="$tmp:/usr/bin:/bin"
  json=$(opencode_free_models_json)
  [[ "$json" == "[]" ]] || { echo "json=$json" >&2; exit 1; }
) && ok "opencode_free_models_json is empty when opencode is missing" || fail "opencode_free_models_json is empty when opencode is missing"

(
  with_stub
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  cat >"$tmp/opencode" <<'EOF'
#!/usr/bin/env bash
if [[ "${1:-}" == "models" ]]; then
  printf '%s\n' 'anthropic/claude-sonnet-5' 'openai/gpt-5.5'
  exit 0
fi
exit 1
EOF
  chmod +x "$tmp/opencode"
  export PATH="$tmp:$PATH"
  json=$(opencode_free_models_json)
  [[ "$json" == "[]" ]] || { echo "json=$json" >&2; exit 1; }
) && ok "opencode_free_models_json is empty when grep free matches nothing" || fail "opencode_free_models_json is empty when grep free matches nothing"

(
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  log="$tmp/stub.log"
  : >"$log"
  unset OPENROUTER_API_KEY || true
  export MULTICA_FREE_AGENT_TEST_NO_KEY=1
  cli "$tmp" "$log" --yes --model opencode/deepseek-v4.1-flash-free --runtime opencode --workspace ws-a --agent AgentOne >/dev/null
  grep -q 'agent update' "$log" || { echo "log=$(cat "$log")" >&2; exit 1; }
  grep -q 'opencode/deepseek-v4.1-flash-free' "$log" || { echo "log=$(cat "$log")" >&2; exit 1; }
  grep -q 'openrouter/opencode/' "$log" && { echo "wrong prefix: $(cat "$log")" >&2; exit 1; }
  if grep -q 'ENVFILE' "$log"; then
    echo "unexpected env set: $(cat "$log")" >&2
    exit 1
  fi
) && ok "--yes zen model needs no key and skips env" || fail "--yes zen model needs no key and skips env"

path_no_opencode() {
  local tmpbin=$1
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$ROOT/tests/stubs/curl" >"$tmpbin/curl"
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$ROOT/tests/stubs/multica" >"$tmpbin/multica"
  chmod +x "$tmpbin/curl" "$tmpbin/multica"
  PATH="$tmpbin:/usr/bin:/bin"
}

(
  tmp=$(mktemp -d)
  tmpbin=$(mktemp -d)
  path_no_opencode "$tmpbin"
  export HOME="$tmp"
  export XDG_CONFIG_HOME="$tmp/.config"
  export OPENROUTER_API_KEY="sk-or-test"
  export MULTICA_FREE_AGENT_NONINTERACTIVE=1
  export PATH
  out=$("$ROOT/bin/multica-free-agent" --list-models)
  printf '%s' "$out" | grep -q 'nvidia/nemotron-3-ultra-550b-a55b:free' || { echo "$out" >&2; exit 1; }
  printf '%s' "$out" | grep -q 'opencode/beam-free' && { echo "opencode leaked: $out" >&2; exit 1; }
  rm -rf "$tmp" "$tmpbin"
) && ok "--list-models without opencode still lists OpenRouter free ids" || fail "--list-models without opencode still lists OpenRouter free ids"

(
  tmp=$(mktemp -d)
  tmpbin=$(mktemp -d)
  path_no_opencode "$tmpbin"
  export HOME="$tmp"
  export XDG_CONFIG_HOME="$tmp/.config"
  unset OPENROUTER_API_KEY || true
  export MULTICA_FREE_AGENT_NONINTERACTIVE=1
  export PATH
  err=$("$ROOT/bin/multica-free-agent" --list-models 2>&1) && { echo "expected fail: $err" >&2; exit 1; }
  printf '%s' "$err" | grep -q 'No OpenRouter API key' || { echo "err=$err" >&2; exit 1; }
  rm -rf "$tmp" "$tmpbin"
) && ok "--list-models without opencode or key falls back to load_api_key" || fail "--list-models without opencode or key falls back to load_api_key"

echo
echo "$PASS passed, $FAIL failed"
[[ "$FAIL" -eq 0 ]]
