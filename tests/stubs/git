#!/usr/bin/env bash
# Test stub for git used by the update-check tests. Responses come from env
# vars so cases stay network-free and deterministic.
if [[ -n "${MULTICA_TEST_GIT_STUB_LOG:-}" ]]; then
  echo "$*" >>"$MULTICA_TEST_GIT_STUB_LOG"
fi
case " $* " in
  *" rev-parse --show-toplevel "*)
    echo "${MULTICA_TEST_REPO:-/tmp/mfa-test-repo}"
    exit 0
    ;;
  *" rev-parse --abbrev-ref HEAD"*)
    echo "${MULTICA_TEST_BRANCH:-main}"
    exit 0
    ;;
  *" rev-parse HEAD"*)
    echo "${MULTICA_TEST_LOCAL_SHA:-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}"
    exit 0
    ;;
  *" rev-parse refs/heads/"*)
    echo "${MULTICA_TEST_LOCAL_SHA:-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}"
    exit 0
    ;;
  *" ls-remote "*)
    printf '%s\trefs/heads/main\n' "${MULTICA_TEST_REMOTE_SHA:-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb}"
    exit 0
    ;;
esac
exit 0
