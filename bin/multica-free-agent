#!/usr/bin/env bash
# List free models (OpenCode catalog + OpenRouter) and point Multica agents at a local harness + that model.
set -euo pipefail

OPENROUTER_MODELS_URL="https://openrouter.ai/api/v1/models"
OR_CAPABLE="opencode omp pi hermes"

config_dir() {
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/multica-free-agent"
}

key_path() {
  echo "$(config_dir)/api_key"
}

save_api_key() {
  local key=$1
  local dir
  dir=$(config_dir)
  mkdir -p "$dir"
  chmod 0700 "$dir"
  local f
  f=$(key_path)
  umask 077
  printf '%s\n' "$key" >"$f"
  chmod 0600 "$f"
}

load_api_key() {
  if [[ -n "${OPENROUTER_API_KEY:-}" ]]; then
    printf '%s\n' "$OPENROUTER_API_KEY"
    return 0
  fi
  local f key=""
  f=$(key_path)
  if [[ -f "$f" ]]; then
    key=$(tr -d '\r\n' <"$f")
    if [[ -n "$key" ]]; then
      printf '%s\n' "$key"
      return 0
    fi
  fi
  if [[ "${MULTICA_FREE_AGENT_NONINTERACTIVE:-}" == "1" ]] || ! { printf '' >/dev/tty; } 2>/dev/null; then
    echo "No OpenRouter API key. Set OPENROUTER_API_KEY or run interactively to cache one at $(key_path)." >&2
    return 1
  fi
  local key=""
  printf 'OpenRouter API key: ' >/dev/tty
  IFS= read -r key </dev/tty || true
  if [[ -z "$key" ]]; then
    echo "Empty key." >&2
    return 1
  fi
  save_api_key "$key"
  printf '%s\n' "$key"
}

fetch_models_json() {
  local key=$1
  local body err
  body=$(mktemp)
  err=$(mktemp)
  if ! curl -fsS -H "Authorization: Bearer ${key}" "$OPENROUTER_MODELS_URL" -o "$body" 2>"$err"; then
    if grep -Eq '401|403' "$err"; then
      echo "OpenRouter API key invalid or expired." >&2
    else
      cat "$err" >&2
    fi
    rm -f "$body" "$err"
    return 1
  fi
  cat "$body"
  rm -f "$body" "$err"
}

free_models_json() {
  jq -c '
    def is_free:
      ((.id // "") | endswith(":free"))
      or (
        ((.pricing.prompt // "1") | tostring) == "0"
        and ((.pricing.completion // "1") | tostring) == "0"
        and ((.pricing.request // "0") | tostring) == "0"
      );
    [.data[]? | select(is_free) | {id, name, context_length}]
    | if any(.[]; .id == "openrouter/free") then . else . + [{id:"openrouter/free", name:"OpenRouter Free Models Router", context_length:null}] end
    | sort_by(.name // .id)
  '
}

runtime_machine_jq() {
  cat <<'JQ'
    if (.device_info // "") != "" then
      (.device_info | split(" · ")[0] | gsub("^\\s+|\\s+$";""))
    elif ((.name // "") | test("\\(")) then
      (.name | capture("\\((?<m>[^)]+)\\)") | .m)
    else
      "unknown"
    end
JQ
}

list_workspaces() {
  multica workspace list --output json
}

list_runtime_groups() {
  local ws acc='[]' wid json
  ws=$(list_workspaces)
  while IFS= read -r wid; do
    [[ -n "$wid" ]] || continue
    json=$(multica runtime list --workspace-id "$wid" --output json)
    acc=$(jq -c --argjson rts "$json" "
      . + [
        \$rts[]
        | select(.status == \"online\" and ((.runtime_mode // \"local\") == \"local\"))
        | {provider, machine: ($(runtime_machine_jq))}
      ]
    " <<<"$acc")
  done < <(printf '%s' "$ws" | jq -r '.[].id')
  jq -c '
    unique_by(.provider, .machine)
    | sort_by(
        (if .provider == "opencode" or .provider == "omp" or .provider == "pi" or .provider == "hermes" then 0 else 1 end),
        .provider,
        .machine
      )
    | map(. + {label: "\(.provider) @ \(.machine)"})
  ' <<<"$acc"
}

list_agents() {
  local ws acc='[]' wid slug agents
  ws=$(list_workspaces)
  while IFS=$'\t' read -r wid slug; do
    [[ -n "$wid" ]] || continue
    agents=$(multica agent list --workspace-id "$wid" --output json)
    acc=$(jq -c --argjson ag "$agents" --arg slug "$slug" --arg wid "$wid" '
      . + [ $ag[] | . + {workspace_slug: $slug, workspace_id: (.workspace_id // $wid)} ]
    ' <<<"$acc")
  done < <(printf '%s' "$ws" | jq -r '.[] | [.id, .slug] | @tsv')
  printf '%s\n' "$acc"
}

resolve_runtime_id() {
  local ws_id=$1 provider=$2 machine=$3
  local json
  json=$(multica runtime list --workspace-id "$ws_id" --output json)
  jq -r --arg p "$provider" --arg m "$machine" "
    [
      .[]
      | select(.status == \"online\" and ((.runtime_mode // \"local\") == \"local\") and .provider == \$p)
      | . as \$r
      | ($(runtime_machine_jq)) as \$machine
      | select(\$machine == \$m)
      | .id
    ] | first // empty
  " <<<"$json"
}

map_model_id() {
  local provider=$1
  local id=$2
  local mapped
  if [[ "$id" == opencode/* ]]; then
    mapped=$id
  elif [[ "$id" == "openrouter/free" ]]; then
    mapped="openrouter/openrouter/free"
  elif [[ "$id" == openrouter/* ]]; then
    mapped=$id
  else
    mapped="openrouter/$id"
  fi
  printf '%s\n' "$mapped"
}

opencode_free_models_json() {
  if ! command -v opencode >/dev/null 2>&1; then
    printf '%s\n' '[]'
    return 0
  fi
  local lines
  lines=$(opencode models 2>/dev/null | grep free || true)
  if [[ -z "$lines" ]]; then
    printf '%s\n' '[]'
    return 0
  fi
  printf '%s\n' "$lines" | jq -R -s -c '
    split("\n")
    | map(select(length > 0))
    | map({id: ., name: ., context_length: null, source: "opencode"})
  '
}

try_openrouter_free_models_json() {
  local key=""
  if [[ -n "${OPENROUTER_API_KEY:-}" ]]; then
    key=$OPENROUTER_API_KEY
  elif [[ -f "$(key_path)" ]]; then
    key=$(tr -d '\r\n' <"$(key_path)")
  fi
  if [[ -z "$key" ]]; then
    printf '%s\n' '[]'
    return 0
  fi
  fetch_models_json "$key" | free_models_json || printf '%s\n' '[]'
}

collect_free_models() {
  local or oc
  or=$(try_openrouter_free_models_json)
  oc=$(opencode_free_models_json)
  if [[ "$(printf '%s' "$or" | jq 'length')" -eq 0 && "$(printf '%s' "$oc" | jq 'length')" -eq 0 ]]; then
    if load_api_key >/dev/null; then
      or=$(try_openrouter_free_models_json)
    fi
  fi
  jq -n -c --argjson or "$or" --argjson oc "$oc" '
    $or + $oc | unique_by(.id) | sort_by(.name // .id)
  '
}

# --- pretty output helpers: colors only when stdout is a tty, NO_COLOR respected ---
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  BOLD=$'\e[1m'
  DIM=$'\e[2m'
  CYAN=$'\e[36m'
  GREEN=$'\e[32m'
  YELLOW=$'\e[33m'
  RED=$'\e[31m'
  RESET=$'\e[0m'
else
  BOLD="" DIM="" CYAN="" GREEN="" YELLOW="" RED="" RESET=""
fi

humanize_len() {
  local n=$1
  [[ "$n" =~ ^[0-9]+$ ]] || return 0
  if (( n >= 1048576 )); then
    printf '%dM' $((n / 1048576))
  elif (( n >= 1024 )); then
    printf '%dk' $((n / 1024))
  else
    printf '%d' "$n"
  fi
}

ui_cols() {
  local cols=${COLUMNS:-}
  [[ "$cols" =~ ^[0-9]+$ ]] || cols=0
  if (( cols == 0 )) && [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    cols=$(tput cols 2>/dev/null) || cols=0
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=0
  fi
  (( cols == 0 )) && cols=80
  printf '%s' "$cols"
}

section() {
  local title=$1 cols bar="" k n
  cols=$(ui_cols)
  n=$((cols - ${#title} - 5))
  (( n < 0 )) && n=0
  for ((k = 0; k < n; k++)); do bar+="─"; done
  printf '%s\n' "${BOLD}${CYAN}── ${title} ${RESET}${DIM}${bar}${RESET}"
}

# --- list commands ---

# --- list commands ---

show_agents_config() {
  local all_ws sel_ws all_ag in_ws labels
  all_ws=$(list_workspaces)
  if [[ ${#workspaces[@]} -gt 0 ]]; then
    sel_ws=$(filter_workspaces "$all_ws" "${workspaces[@]}")
  else
    sel_ws=$all_ws
  fi
  [[ "$(printf '%s' "$sel_ws" | jq 'length')" -gt 0 ]] || die "No matching workspaces."
  all_ag=$(list_agents)
  in_ws=$(filter_agents "$all_ag" "$sel_ws" "${agentsel[@]}")
  local n
  n=$(printf '%s' "$in_ws" | jq 'length')
  [[ "$n" -gt 0 ]] || die "No matching agents."
  labels=$(runtime_labels_json)

  local a_name=() a_slug=() a_rt=() a_model=() a_keys=() a_mika=() \
    aid aslug aname aw_id art amodel amika an \
    maxn=0 maxs=0 maxrt=0 maxmo=0 ai
  while IFS=$'\t' read -r aid aslug aname aw_id art amodel amika; do
    [[ -n "$aid" ]] || continue
    [[ -n "$amodel" ]] || amodel="-"
    an=$(multica agent env get "$aid" --workspace-id "$aw_id" --output json 2>/dev/null | \
      jq -r '(.custom_env // {}) | keys | join(", ")' || true)
    [[ -n "$an" ]] || an="-"
    a_slug+=("$aslug"); a_name+=("$aname"); a_rt+=("$art")
    a_model+=("$amodel"); a_keys+=("$an"); a_mika+=("$amika")
    (( ${#aname} > maxn )) && maxn=${#aname}
    (( ${#aslug} > maxs )) && maxs=${#aslug}
    (( ${#art} > maxrt )) && maxrt=${#art}
    (( ${#amodel} > maxmo )) && maxmo=${#amodel}
  done < <(printf '%s' "$in_ws" | jq -r --argjson L "$labels" \
    '.[] | [.id, .workspace_slug, .name, .workspace_id, ($L[.runtime_id] // "unknown"), (.model // ""), (if .system_key then "[mika]" else "" end)] | @tsv')

  local maxkey k
  maxkey=0
  for ai in "${!a_keys[@]}"; do
    (( ${#a_keys[$ai]} > maxkey )) && maxkey=${#a_keys[$ai]}
  done
  # effective column widths include the header labels themselves
  local ws_w=${maxs} name_w=${maxn} rt_w=${maxrt} mo_w=${maxmo} key_w=${maxkey}
  (( ws_w < 9 )) && ws_w=9
  (( name_w < 5 )) && name_w=5
  (( rt_w < 7 )) && rt_w=7
  (( mo_w < 5 )) && mo_w=5
  (( key_w < 8 )) && key_w=8
  section "Agents (${#a_name[@]})"
  printf '%s  %-*s  %-*s  %-*s  %-*s  %-*s%s\n' "$BOLD" \
    "$ws_w" "workspace" "$name_w" "agent" "$rt_w" "runtime" \
    "$mo_w" "model" "$key_w" "env keys" "$RESET"
  for ai in "${!a_name[@]}"; do
    printf '  %-*s  %s%-*s%s  %s%-*s%s  %s%-*s%s  %s%-*s%s  %s\n' \
      "$ws_w" "${a_slug[$ai]}" \
      "$BOLD" "$name_w" "${a_name[$ai]}" "$RESET" \
      "$DIM" "$rt_w" "${a_rt[$ai]}" "$RESET" \
      "$DIM" "$mo_w" "${a_model[$ai]}" "$RESET" \
      "$DIM" "$key_w" "${a_keys[$ai]}" "$RESET" \
      "$( [[ -n "${a_mika[$ai]}" ]] && printf '%s%s%s' "$YELLOW" "${a_mika[$ai]}" "$RESET" )"
  done
}

show_models_tsv() {
  local models
  models=$(collect_free_models)
  [[ "$(printf '%s' "$models" | jq 'length')" -gt 0 ]] || die "No free models. Install opencode or set OPENROUTER_API_KEY."
  print_models "$models"
}

show_workspaces() {
  local ws_all
  ws_all=$(list_workspaces)
  section "Workspaces ($(printf '%s' "$ws_all" | jq 'length'))"
  while IFS=$'\t' read -r wslug wname wid; do
    [[ -n "$wslug" ]] || continue
    printf '  %s%s%s  %s%s%s  %s(%s)%s\n' \
      "$BOLD" "$wslug" "$RESET" "$DIM" "$wname" "$RESET" \
      "$DIM" "$wid" "$RESET"
  done < <(printf '%s' "$ws_all" | jq -r '.[] | "\(.slug)\t\(.name)\t\(.id)"')
}

show_runtimes() {
  local rgroups
  rgroups=$(list_runtime_groups)
  section "Online local runtimes ($(printf '%s' "$rgroups" | jq 'length'))"
  printf '%s' "$rgroups" | jq -r '.[] | "  " + .label'
}

# Installs this script into the user's own bin dir so it can be run from
# anywhere as `multica-free-agent`. Prefers a dir already on PATH.
install_to_user_bin() {
  local self dst d
  self=${BASH_SOURCE[0]}
  if command -v readlink >/dev/null 2>&1; then
    self=$(readlink -f "$self" 2>/dev/null) || true
  fi
  [[ -n "$self" && -f "$self" ]] || die "Cannot locate this script; install it manually."
  dst=""
  for d in "$HOME/.local/bin" "$HOME/bin"; do
    if [[ -d "$d" && ":$PATH:" == *":$d:"* ]]; then
      dst=$d
      break
    fi
  done
  if [[ -z "$dst" ]]; then
    for d in "$HOME/.local/bin" "$HOME/bin"; do
      if [[ -e "$d" ]]; then
        dst=$d
        break
      fi
    done
  fi
  [[ -n "$dst" ]] || dst="$HOME/.local/bin"
  mkdir -p "$dst"
  if [[ "$self" != "$dst/multica-free-agent" ]]; then
    cp "$self" "$dst/multica-free-agent"
    chmod 0755 "$dst/multica-free-agent"
  fi
  if [[ ":$PATH:" == *":$dst:"* ]]; then
    printf '%s✔%s installed at %s — run "multica-free-agent" from anywhere.\n' "$GREEN" "$RESET" "$dst/multica-free-agent"
  else
    printf '%s✔%s installed at %s\n' "$GREEN" "$RESET" "$dst/multica-free-agent"
    printf '%snot on PATH: add with  export PATH="%s:$PATH"%s\n' "$YELLOW" "$dst" "$RESET"
  fi
}

# Interactive top menu. Empty input or 1 starts the setup flow.
# install is always the second-to-last item and exit is always last,
# regardless of how many list entries are added.
main_menu() {
  local -a items=(
    "configure agents (model → runtime → workspaces → agents)"
    "review agent configuration"
    "browse free model catalog"
    "browse workspace directory"
    "review online local runtimes"
    "deploy CLI to user bin (run from any directory)"
    "exit"
  )
  local n=${#items[@]} reply
  local install_idx=$((n - 1)) exit_idx=$n
  while true; do
    section "multica-free-agent"
    local i
    for i in "${!items[@]}"; do
      printf '  %s%2d%s) %s\n' "$BOLD" $((i+1)) "$RESET" "${items[i]}"
    done
    reply=$(prompt_read "Choose [1-${n}, Enter=1]: ")
    case "$reply" in
      ""|1) return 0 ;;
      2) show_agents_config ;;
      3) show_models_tsv ;;
      4) show_workspaces ;;
      5) show_runtimes ;;
      "$install_idx") install_to_user_bin ;;
      "$exit_idx"|q|exit) exit 0 ;;
      *) echo "Unknown choice: $reply" >&2 ;;
    esac
    prompt_read "Press Enter to continue... " >/dev/null
  done
}

# Returns 1 (and prints nothing) when the running copy is behind origin's
# branch head. 0 on any failure/unknown state so callers stay silent.
# Skipped entirely with MULTICA_FREE_AGENT_NO_UPDATE_CHECK=1. Results are
# cached ~24h under the config dir; runs from an installed copy outside a
# git repo are silently skipped (reinstall via --install to update those).
update_available() {
  [[ "${MULTICA_FREE_AGENT_NO_UPDATE_CHECK:-}" == "1" ]] && return 0
  command -v git >/dev/null 2>&1 || return 0
  local self repo branch local_sha remote_sha cache ts cached_branch cached_sha now
  self=${BASH_SOURCE[0]}
  if command -v readlink >/dev/null 2>&1; then
    self=$(readlink -f "$self" 2>/dev/null) || true
  fi
  [[ -n "$self" && -f "$self" ]] || return 0
  repo=$(git -C "$(dirname "$self")" rev-parse --show-toplevel 2>/dev/null) || return 0
  branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
  [[ -n "$branch" && "$branch" != "HEAD" ]] || branch=main
  local_sha=$(git -C "$repo" rev-parse "refs/heads/$branch" 2>/dev/null) || \
    local_sha=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || return 0
  cache="$(config_dir)/update_check"
  now=$(date +%s)
  if [[ -f "$cache" ]]; then
    read -r ts cached_branch cached_sha <"$cache" 2>/dev/null || { ts=""; cached_branch=""; cached_sha=""; }
    if [[ "$ts" =~ ^[0-9]+$ && "$cached_branch" == "$branch" && $(( now - ts )) -lt 86400 ]]; then
      remote_sha=$cached_sha
    fi
  fi
  if [[ -z "${remote_sha:-}" ]]; then
    remote_sha=$(GIT_TERMINAL_PROMPT=0 git -C "$repo" ls-remote origin "refs/heads/$branch" 2>/dev/null | awk 'NR==1{print $1}')
    if [[ "$remote_sha" =~ ^[0-9a-f]{7,40}$ ]]; then
      mkdir -p "$(config_dir)" 2>/dev/null || true
      printf '%s %s %s\n' "$now" "$branch" "$remote_sha" >"$cache" 2>/dev/null || true
    else
      return 0 # offline, private repo, etc. — stay silent
    fi
  fi
  [[ -z "${local_sha:-}" ]] && return 0
  if [[ "$local_sha" != "$remote_sha" ]]; then
    return 1
  fi
  return 0
}

update_warning() {
  printf '%sⓘ a newer version is on git: please run git pull%s (and reinstall with --install if you use an installed copy)\n' \
    "$YELLOW" "$RESET"
}

if [[ "${MULTICA_FREE_AGENT_LIB:-}" == "1" ]]; then
  return 0 2>/dev/null || exit 0
fi



die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: multica-free-agent [command] [flags]

Run with NO flags for the interactive menu. Menu choice 1 (or Enter) is
always setup agents; install is always the second-to-last item and exit
is always the last item.

Commands:
  1. setup agents      Interactive pick of model, harness, runtime machine,
                       workspaces and agents, then apply. (menu default)
  2. --list-agents     Show every agent's config: workspace, runtime,
                       model, custom_env key names (values never shown).
  3. --list-models     Print free models as TSV and exit.
  4. --list-workspaces Print workspaces (slug, name, id) and exit.
  5. --list-runtimes   Print online local runtimes and exit.
  6. --install         Copy this script into your user bin (prefers a dir
                       already on PATH: ~/.local/bin, ~/bin) so it can be
                       run from anywhere as "multica-free-agent".

  --list-agents, --list-workspaces and setup accept the filters below.

Flags:
  --install           Non-interactive install into your user bin
  --dry-run           Print the apply table and exit
  --yes               Apply without a confirm prompt
  --model ID          Model id (opencode/…-free or nvidia/foo:free)
  --runtime PROVIDER  Harness provider (opencode, omp, pi, hermes, ...)
  --machine NAME      Machine name (default: the only online one)
  --workspace SLUG    Workspace slug/name/id (repeatable)
  --agent NAME_OR_ID  Agent name or id (repeatable)
  --env               Merge OPENROUTER_API_KEY into each agent's custom_env
  --no-env            Do not change custom_env
  -h, --help          Show this help

Key cache: ${XDG_CONFIG_HOME:-$HOME/.config}/multica-free-agent/api_key
EOF
}

tty_in() {
  if [[ "${MULTICA_FREE_AGENT_NONINTERACTIVE:-}" == "1" ]]; then
    return 1
  fi
  { printf '' >/dev/tty; } 2>/dev/null
}

prompt_read() {
  local prompt=$1
  local reply=""
  printf '%s' "$prompt" >/dev/tty
  IFS= read -r reply </dev/tty || true
  printf '%s\n' "$reply"
}

prompt_yn() {
  local prompt=$1
  local default=$2
  local reply
  reply=$(prompt_read "$prompt")
  if [[ -z "$reply" ]]; then
    reply=$default
  fi
  case "$reply" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

is_or_capable() {
  local p=$1
  [[ " $OR_CAPABLE " == *" $p "* ]]
}

print_models() {
  local json=$1
  printf '%s' "$json" | jq -r '.[] | [.id, (.name // ""), ((.context_length // "") | tostring)] | @tsv'
}

filter_workspaces() {
  local all=$1
  shift
  if [[ $# -eq 0 ]]; then
    printf '%s\n' "$all"
    return 0
  fi
  local qjson
  qjson=$(printf '%s\n' "$@" | jq -R . | jq -s .)
  printf '%s' "$all" | jq -c --argjson qs "$qjson" '
    [.[] | select(. as $w | $qs | any(. == $w.slug or . == $w.id or . == $w.name))]
  '
}

filter_agents() {
  local all=$1
  local wsjson=$2
  shift 2
  local wsids
  wsids=$(printf '%s' "$wsjson" | jq -c '[.[].id]')
  local filtered
  filtered=$(printf '%s' "$all" | jq -c --argjson ids "$wsids" '[.[] | select(.workspace_id as $w | $ids | index($w))]')
  if [[ $# -eq 0 ]]; then
    printf '%s\n' "$filtered"
    return 0
  fi
  local qjson
  qjson=$(printf '%s\n' "$@" | jq -R . | jq -s .)
  printf '%s' "$filtered" | jq -c --argjson qs "$qjson" '
    [.[] | select(. as $a | $qs | any(. == $a.name or . == $a.id))]
  '
}


runtime_label_for() {
  local ws_id=$1 runtime_id=$2
  local json
  json=$(multica runtime list --workspace-id "$ws_id" --output json)
  printf '%s' "$json" | jq -r --arg id "$runtime_id" "
    [.[] | select(.id == \$id) | {provider, machine: ($(runtime_machine_jq))}]
    | first
    | if . == null then \"unknown\" else \"\(.provider) @ \(.machine)\" end
  "
}

runtime_labels_json() {
  local ws acc='{}' wid json
  ws=$(list_workspaces)
  while IFS= read -r wid; do
    [[ -n "$wid" ]] || continue
    json=$(multica runtime list --workspace-id "$wid" --output json)
    acc=$(jq -c --argjson rts "$json" "
      . + (
        [ \$rts[] | {key: .id, value: \"\(.provider) @ \($(runtime_machine_jq))\"} ]
        | from_entries
      )
    " <<<"$acc")
  done < <(printf '%s' "$ws" | jq -r '.[].id')
  printf '%s\n' "$acc"
}

pick_index() {
  local n=$1
  local label=$2
  local reply i
  reply=$(prompt_read "Choose ${label} [1-${n}]: ")
  [[ "$reply" =~ ^[0-9]+$ ]] || die "Not a number."
  i=$reply
  if [[ "$i" -lt 1 || "$i" -gt "$n" ]]; then
    die "Choice out of range."
  fi
  printf '%s\n' "$i"
}

pick_multi() {
  local n=$1
  local label=$2
  local reply
  reply=$(prompt_read "Select ${label} (a=all, comma indexes) [a]: ")
  if [[ -z "$reply" || "$reply" == "a" || "$reply" == "A" ]]; then
    printf 'a\n'
    return 0
  fi
  printf '%s\n' "$reply"
}

indexes_to_json() {
  local arr_json=$1
  local spec=$2
  if [[ "$spec" == "a" ]]; then
    printf '%s\n' "$arr_json"
    return 0
  fi
  local idxs
  idxs=$(printf '%s' "$spec" | tr ',' '\n' | jq -R . | jq -s '[.[] | select(length>0) | tonumber]')
  printf '%s' "$arr_json" | jq -c --argjson idxs "$idxs" '[range(length) as $i | select($idxs | index($i+1)) | .[$i]]'
}

merge_env_file() {
  local agent_id=$1 ws_id=$2 key=$3 dest=$4
  local got
  got=$(multica agent env get "$agent_id" --workspace-id "$ws_id" --output json)
  printf '%s' "$got" | jq -c --arg k "$key" '
    ((.custom_env // {}) | to_entries | map({key: .key, value: "****"}) | from_entries)
    + {OPENROUTER_API_KEY: $k}
  ' >"$dest"
  chmod 0600 "$dest"
}

apply_one() {
  local agent_id=$1 ws_id=$2 rid=$3 mapped=$4 write_env=$5 key=$6
  local tmp=""
  if ! multica agent update "$agent_id" \
    --workspace-id "$ws_id" \
    --runtime-id "$rid" \
    --model "$mapped" \
    --output json >/dev/null; then
    return 1
  fi
  if [[ "$write_env" == "1" ]]; then
    tmp=$(mktemp)
    merge_env_file "$agent_id" "$ws_id" "$key" "$tmp"
    if ! multica agent env set "$agent_id" \
      --workspace-id "$ws_id" \
      --custom-env-file "$tmp" \
      --output json >/dev/null; then
      rm -f "$tmp"
      return 1
    fi
    rm -f "$tmp"
  fi
  return 0
}

main() {
  local list_models=0 dry_run=0 yes=0 list_agents=0 list_workspaces=0 list_runtimes=0 do_install=0
  local write_env=""
  local model="" runtime="" machine=""
  local workspaces=() agentsel=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --list-models) list_models=1 ;;
      --install) do_install=1 ;;
      --list-agents) list_agents=1 ;;
      --list-workspaces) list_workspaces=1 ;;
      --list-runtimes) list_runtimes=1 ;;
      --dry-run) dry_run=1 ;;
      --yes) yes=1 ;;
      --env) write_env=1 ;;
      --no-env) write_env=0 ;;
      --model)
        shift
        [[ $# -ge 1 ]] || die "--model needs a value"
        model=$1
        ;;
      --runtime)
        shift
        [[ $# -ge 1 ]] || die "--runtime needs a value"
        runtime=$1
        ;;
      --machine)
        shift
        [[ $# -ge 1 ]] || die "--machine needs a value"
        machine=$1
        ;;
      --workspace)
        shift
        [[ $# -ge 1 ]] || die "--workspace needs a value"
        workspaces+=("$1")
        ;;
      --agent)
        shift
        [[ $# -ge 1 ]] || die "--agent needs a value"
        agentsel+=("$1")
        ;;
      *)
        die "Unknown flag: $1"
        ;;
    esac
    shift
  done

  # Small "you're behind origin" hint on interactive runs only.
  if [[ "${MULTICA_FREE_AGENT_NONINTERACTIVE:-}" != "1" ]]; then
    update_available || update_warning
  fi

  if [[ $do_install -eq 1 ]]; then
    install_to_user_bin
    exit 0
  fi

  if [[ $list_workspaces -eq 1 ]]; then
    show_workspaces
    exit 0
  fi

  if [[ $list_runtimes -eq 1 ]]; then
    show_runtimes
    exit 0
  fi

  if [[ $list_agents -eq 1 ]]; then
    show_agents_config
    exit 0
  fi

  if [[ $list_models -eq 1 ]]; then
    show_models_tsv
    exit 0
  fi

  # Interactive top menu: setup stays option 1, install second-to-last, exit last.
  if tty_in && [[ -z "$model" && -z "$runtime" && $dry_run -eq 0 && $yes -eq 0 && $list_models -eq 0 ]]; then
    main_menu
  fi

  if [[ $yes -eq 1 || $dry_run -eq 1 ]]; then
    if ! tty_in; then
      [[ -n "$model" ]] || die "--model is required with --yes/--dry-run"
      [[ -n "$runtime" ]] || die "--runtime is required with --yes/--dry-run"
    fi
  fi

  local models_json=""
  local key=""
  if [[ -z "$model" ]]; then
    models_json=$(collect_free_models)
    if tty_in; then
      local n i
      n=$(printf '%s' "$models_json" | jq 'length')
      [[ "$n" -gt 0 ]] || die "No free models. Install opencode or set OPENROUTER_API_KEY."
      section "Free models (${n})"
      local list_ids=() list_names=() list_ctx=() maxid=0 maxname=0 lid lname lctx
      while IFS=$'\t' read -r lid lname lctx; do
        [[ -n "$lid" ]] || continue
        list_ids+=("$lid"); list_names+=("$lname"); list_ctx+=("$lctx")
        (( ${#lid} > maxid )) && maxid=${#lid}
        (( ${#lname} > maxname )) && maxname=${#lname}
      done < <(print_models "$models_json")
      # OpenCode-catalog rows carry no display name; only show a name/context
      # column when some row actually has one.
      local show_name=0 show_ctx=0 li
      for li in "${!list_ids[@]}"; do
        [[ "${list_names[li]}" != "" && "${list_names[li]}" != "${list_ids[li]}" ]] && show_name=1
        [[ -n "${list_ctx[li]}" ]] && show_ctx=1
      done
      (( show_name == 0 )) && maxname=0
      for li in "${!list_ids[@]}"; do
        printf '  %2d) %-*s' $((li + 1)) "$maxid" "${list_ids[li]}"
        (( show_name == 1 )) && printf '  %s%-*s%s' "$DIM" "$maxname" "${list_names[li]}" "$RESET"
        (( show_ctx == 1 )) && printf '  %s%s%s' "$DIM" "$(humanize_len "${list_ctx[li]}")" "$RESET"
        printf '\n'
      done
      i=$(pick_index "$n" "model")
      model=$(printf '%s' "$models_json" | jq -r --argjson i "$i" '.[$i-1].id')
    else
      die "--model is required in non-interactive mode"
    fi
  fi

  local groups
  groups=$(list_runtime_groups)
  if [[ -z "$runtime" ]]; then
    if tty_in; then
      local n i p
      n=$(printf '%s' "$groups" | jq 'length')
      [[ "$n" -gt 0 ]] || die "No online local runtimes."
      section "Online local harnesses (${n})"
      local glabels=() gl
      while IFS= read -r gl; do
        [[ -n "$gl" ]] || continue
        glabels+=("$gl")
      done < <(printf '%s' "$groups" | jq -r '.[] | .label')
      local gi
      for gi in "${!glabels[@]}"; do
        printf '  %2d) %s\n' $((gi + 1)) "${glabels[gi]}"
      done
      i=$(pick_index "$n" "harness")
      runtime=$(printf '%s' "$groups" | jq -r --argjson i "$i" '.[$i-1].provider')
      machine=$(printf '%s' "$groups" | jq -r --argjson i "$i" '.[$i-1].machine')
    else
      die "--runtime is required in non-interactive mode"
    fi
  fi

  if [[ -z "$machine" ]]; then
    local ms count
    ms=$(printf '%s' "$groups" | jq -r --arg p "$runtime" '.[] | select(.provider == $p) | .machine')
    count=$(printf '%s\n' "$ms" | grep -c . || true)
    if [[ "$count" -eq 0 ]]; then
      die "No online local $runtime runtime."
    elif [[ "$count" -eq 1 ]]; then
      machine=$ms
    elif tty_in; then
      section "Machines for $runtime (${count})"
      local mlines=() ml
      while IFS= read -r ml; do
        [[ -n "$ml" ]] || continue
        mlines+=("$ml")
      done <<<"$ms"
      local mi
      for mi in "${!mlines[@]}"; do
        printf '  %2d) %s\n' $((mi + 1)) "${mlines[mi]}"
      done
      local i
      i=$(pick_index "$count" "machine")
      machine=$(printf '%s\n' "$ms" | sed -n "${i}p")
    else
      die "--machine is required (more than one online machine for $runtime)"
    fi
  fi

  if [[ "$model" == opencode/* && "$runtime" != "opencode" ]]; then
    echo "Warning: $model is an OpenCode catalog id; $runtime may reject it. Prefer --runtime opencode." >&2
  elif [[ "$model" != opencode/* ]] && ! is_or_capable "$runtime"; then
    echo "Warning: $runtime is not known to accept OpenRouter model ids (opencode/omp/pi/hermes). Multica may reject the model." >&2
  fi

  local all_ws sel_ws
  all_ws=$(list_workspaces)
  if [[ ${#workspaces[@]} -gt 0 ]]; then
    sel_ws=$(filter_workspaces "$all_ws" "${workspaces[@]}")
  elif tty_in && [[ $yes -eq 0 ]]; then
    section "Workspaces"
    local wslugs=() wnames=() wslug wname maxwslug=0 wi
    while IFS=$'\t' read -r wslug wname; do
      [[ -n "$wslug" ]] || continue
      wslugs+=("$wslug"); wnames+=("$wname")
      (( ${#wslug} > maxwslug )) && maxwslug=${#wslug}
    done < <(printf '%s' "$all_ws" | jq -r '.[] | "\(.slug)\t\(.name)"')
    for wi in "${!wslugs[@]}"; do
      printf '  %2d) %s%-*s%s  %s%s%s\n' \
        $((wi + 1)) "$BOLD" "$maxwslug" "${wslugs[wi]}" "$RESET" \
        "$DIM" "${wnames[wi]}" "$RESET"
    done
    local n spec
    n=$(printf '%s' "$all_ws" | jq 'length')
    spec=$(pick_multi "$n" "workspaces")
    sel_ws=$(indexes_to_json "$all_ws" "$spec")
  else
    sel_ws=$all_ws
  fi
  [[ "$(printf '%s' "$sel_ws" | jq 'length')" -gt 0 ]] || die "No matching workspaces."

  local all_ag sel_ag
  all_ag=$(list_agents)
  if [[ ${#agentsel[@]} -gt 0 ]]; then
    sel_ag=$(filter_agents "$all_ag" "$sel_ws" "${agentsel[@]}")
  elif tty_in && [[ $yes -eq 0 ]]; then
    local in_ws n spec
    in_ws=$(filter_agents "$all_ag" "$sel_ws")
    section "Agents"
    local a_slugs=() a_names=() a_rts=() a_models=() a_mika=() \
      aslug aname art amodel amika maxaslug=0 maxaname=0 maxart=0 maxamodel=0 ai
    local labels
    labels=$(runtime_labels_json)
    while IFS=$'\t' read -r aslug aname art amodel amika; do
      [[ -n "$aslug" ]] || continue
      a_slugs+=("$aslug"); a_names+=("$aname"); a_rts+=("$art")
      a_models+=("$amodel"); a_mika+=("$amika")
      (( ${#aslug} > maxaslug )) && maxaslug=${#aslug}
      (( ${#aname} > maxaname )) && maxaname=${#aname}
      (( ${#art} > maxart )) && maxart=${#art}
      (( ${#amodel} > maxamodel )) && maxamodel=${#amodel}
    done < <(printf '%s' "$in_ws" | jq -r --argjson L "$labels" \
      '.[] | "\(.workspace_slug)\t\(.name)\t\($L[.runtime_id] // "unknown")\t\(.model // "")\t\(if .system_key then "[mika]" else "" end)"')
    for ai in "${!a_slugs[@]}"; do
      printf '  %2d) %-*s  %s%-*s%s  %s%-*s%s  %s%-*s%s  %s\n' \
        $((ai + 1)) "$maxaslug" "${a_slugs[ai]}" \
        "$BOLD" "$maxaname" "${a_names[ai]}" "$RESET" \
        "$DIM" "$maxart" "${a_rts[ai]}" "$RESET" \
        "$DIM" "$maxamodel" "${a_models[ai]}" "$RESET" \
        "$( [[ -n "${a_mika[ai]}" ]] && printf '%s%s%s' "$YELLOW" "${a_mika[ai]}" "$RESET" )"
    done
    n=$(printf '%s' "$in_ws" | jq 'length')
    [[ "$n" -gt 0 ]] || die "No agents in the selected workspaces."
    spec=$(pick_multi "$n" "agents")
    sel_ag=$(indexes_to_json "$in_ws" "$spec")
  else
    sel_ag=$(filter_agents "$all_ag" "$sel_ws")
  fi
  [[ "$(printf '%s' "$sel_ag" | jq 'length')" -gt 0 ]] || die "No matching agents."

  if [[ -z "$write_env" ]]; then
    if [[ $dry_run -eq 1 ]]; then
      write_env=0
    elif [[ "$model" == opencode/* ]]; then
      write_env=0
    elif tty_in && [[ $yes -eq 0 ]]; then
      if prompt_yn "Write OPENROUTER_API_KEY into each agent's custom_env? [Y/n] " Y; then
        write_env=1
      else
        write_env=0
      fi
    else
      write_env=1
    fi
  fi

  if [[ "$write_env" == "1" && $dry_run -eq 0 ]]; then
    [[ -n "$key" ]] || key=$(load_api_key)
  fi

  local mapped
  mapped=$(map_model_id "$runtime" "$model")

  section "Apply"
  local rows='[]'
  local skipped=0
  local -a d_kind=() d_slug=() d_agent=() d_ort=() d_omodel=() d_nrt=() d_nmodel=()
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    local aid aname ws_id wslug old_model old_rt rid
    aid=$(printf '%s' "$row" | jq -r '.id')
    aname=$(printf '%s' "$row" | jq -r '.name')
    ws_id=$(printf '%s' "$row" | jq -r '.workspace_id')
    wslug=$(printf '%s' "$row" | jq -r '.workspace_slug')
    old_model=$(printf '%s' "$row" | jq -r '.model // ""')
    old_rt=$(runtime_label_for "$ws_id" "$(printf '%s' "$row" | jq -r '.runtime_id // ""')")
    rid=$(resolve_runtime_id "$ws_id" "$runtime" "$machine" || true)
    if [[ -z "$rid" ]]; then
      d_kind+=(S); d_slug+=("$wslug"); d_agent+=("$aname")
      d_ort+=("$old_rt"); d_omodel+=("$old_model")
      d_nrt+=("SKIP"); d_nmodel+=("no $runtime @ $machine")
      skipped=$((skipped + 1))
      continue
    fi
    d_kind+=(A); d_slug+=("$wslug"); d_agent+=("$aname")
    d_ort+=("$old_rt"); d_omodel+=("$old_model")
    d_nrt+=("$runtime @ $machine"); d_nmodel+=("$mapped")
    rows=$(jq -c --arg id "$aid" --arg ws "$ws_id" --arg rid "$rid" --argjson env "$write_env" \
      '. + [{id:$id, workspace_id:$ws, runtime_id:$rid, write_env:$env}]' <<<"$rows")
  done < <(printf '%s' "$sel_ag" | jq -c '.[]')

  local w_slug=0 w_agent=0 w_ort=0 w_omodel=0 w_nrt=0 w_nmodel=0 dj
  for dj in "${!d_kind[@]}"; do
    (( ${#d_slug[$dj]} > w_slug )) && w_slug=${#d_slug[$dj]}
    (( ${#d_agent[$dj]} > w_agent )) && w_agent=${#d_agent[$dj]}
    (( ${#d_ort[$dj]} > w_ort )) && w_ort=${#d_ort[$dj]}
    (( ${#d_omodel[$dj]} > w_omodel )) && w_omodel=${#d_omodel[$dj]}
    (( ${#d_nrt[$dj]} > w_nrt )) && w_nrt=${#d_nrt[$dj]}
    (( ${#d_nmodel[$dj]} > w_nmodel )) && w_nmodel=${#d_nmodel[$dj]}
  done
  printf '%s  %-*s  %-*s  %-*s  %-*s   ->  %-*s  %-*s%s\n' \
    "$BOLD" "$w_slug" "workspace" "$w_agent" "agent" \
    "$w_ort" "old runtime" "$w_omodel" "old model" \
    "$w_nrt" "new runtime" "$w_nmodel" "new model" "$RESET"
  for dj in "${!d_kind[@]}"; do
    if [[ "${d_kind[$dj]}" == S ]]; then
      printf '  %-*s  %-*s  %s%-*s%s  %s%-*s%s  %sSKIP%s: %s\n' \
        "$w_slug" "${d_slug[$dj]}" "$w_agent" "${d_agent[$dj]}" \
        "$DIM" "$w_ort" "${d_ort[$dj]}" "$RESET" \
        "$DIM" "$w_omodel" "${d_omodel[$dj]}" "$RESET" \
        "$YELLOW" "$RESET" "${d_nmodel[$dj]}"
    else
      printf '  %-*s  %-*s  %s%-*s%s  %s%-*s%s  %s->%s  %-*s  %s%s%s\n' \
        "$w_slug" "${d_slug[$dj]}" "$w_agent" "${d_agent[$dj]}" \
        "$DIM" "$w_ort" "${d_ort[$dj]}" "$RESET" \
        "$DIM" "$w_omodel" "${d_omodel[$dj]}" "$RESET" \
        "$CYAN" "$RESET" "$w_nrt" "${d_nrt[$dj]}" \
        "$BOLD$CYAN" "${d_nmodel[$dj]}" "$RESET"
    fi
  done

  local napply
  napply=$(printf '%s' "$rows" | jq 'length')
  if [[ "$napply" -eq 0 ]]; then
    die "Nothing to apply ($skipped skipped)."
  fi

  if [[ $dry_run -eq 1 ]]; then
    echo
    echo "Dry run. $napply agent(s) would be updated ($skipped skipped). env=$write_env"
    exit 0
  fi

  if [[ $yes -eq 0 ]]; then
    if tty_in; then
      prompt_yn "Proceed? [y/N] " N || die "Aborted."
    else
      die "Refusing to apply without --yes on a non-tty."
    fi
  fi

  local failed=0
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    local aid ws_id rid we
    aid=$(printf '%s' "$row" | jq -r '.id')
    ws_id=$(printf '%s' "$row" | jq -r '.workspace_id')
    rid=$(printf '%s' "$row" | jq -r '.runtime_id')
    we=$(printf '%s' "$row" | jq -r '.write_env')
    if apply_one "$aid" "$ws_id" "$rid" "$mapped" "$we" "$key"; then
      printf '%sok%s %s\n' "$GREEN" "$RESET" "$aid"
    else
      printf '%sFAIL%s %s\n' "$RED" "$RESET" "$aid" >&2
      failed=$((failed + 1))
    fi
  done < <(printf '%s' "$rows" | jq -c '.[]')

  if [[ "$failed" -gt 0 ]]; then
    die "$failed agent(s) failed."
  fi
  printf '%s✔%s Updated %d agent(s).\n' "$GREEN" "$RESET" "$napply"
}

main "$@"
